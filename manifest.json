{
  "manifest_version": 3,
  "name": "PrivacyGuard",
  "version": "1.0",
  "description": "A browser privacy extension that analyzes and manages website cookies.",

  "action": {
    "default_popup": "frontend/popup/popup.html",
    "default_title": "PrivacyGuard"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "tabs",
    "cookies"
  ],

  "host_permissions": [
    "<all_urls>"
  ]
}
